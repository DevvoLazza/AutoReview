{
  "name": "reviewguard",
  "version": "0.1.0",
  "private": true,
  "description": "Human-controlled AI review reply platform for Google Business Profile.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "typecheck": "turbo typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:generate": "pnpm --filter @reviewguard/database db:generate",
    "db:migrate": "pnpm --filter @reviewguard/database db:migrate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@types/node": "24.10.1",
    "@vitest/coverage-v8": "5.0.1",
    "turbo": "2.10.13",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
